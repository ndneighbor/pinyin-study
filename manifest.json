{
  "manifest_version": 3,
  "name": "Pinyin Study",
  "version": "1.4.3",
  "description": "Select Chinese text to see Mandarin pinyin. Offline, with tone marks and alternate readings.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pinyin Study",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vendor/pinyin-pro.js",
        "reading.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "author": "Angelo Saraceno",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
